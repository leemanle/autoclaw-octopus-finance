{
  "allow": [
    "bash($ErrorActionPreference = 'Stop')",
    "bash($results = @())",
    "bash($candidates = @()",
    "bash([\"C:\\\\Program Files\\\\QCLAW,\"])",
    "bash([\"C:\\\\Program Files (x86)\\\\QCLAW,\"])",
    "bash(\"$env:LOCALAPPDATA\\QCLAW\",)",
    "bash(\"$env:APPDATA\\QCLAW\",)",
    "bash(\"$env:USERPROFILE\\QCLAW\",)",
    "bash([\"C:\\\\QCLAW,\"])",
    "bash([\"D:\\\\QCLAW\"])",
    "bash(foreach:*)",
    "bash((Test-Path -Path $p) {)",
    "bash($results += [PSCustomObject]@{ Path = $p)",
    "bash(Exists = $true)",
    "bash($drives = Get-PSDrive -PSProvider FileSystem)",
    "bash(Where-Object { $_.Used -ne $null -and $_.Root -ne $null })",
    "bash($found = @())",
    "bash($root = $drv.Root)",
    "bash(Write-Host \"Scanning drive $root ...\")",
    "bash(try:*)",
    "bash($dirs = Get-ChildItem -Path $root -Filter 'QCLAW' -Directory -ErrorAction SilentlyContinue -Force)",
    "bash($found += [PSCustomObject]@{ Path = $d.FullName)",
    "bash(Root = $root)",
    "bash(Depth = 0 })",
    "bash(catch:*)",
    "bash(Write-Host \"Skip $root : $($_.Exception.Message)\")",
    "bash($miniMaxRoots = @('C:\\Users\\Administrator\\.minimax'))",
    "bash((Test-Path -Path $m) {)",
    "bash($results += [PSCustomObject]@{ Path = $m)",
    "bash(Get-ChildItem -Path $m -Recurse -Directory -Filter '*qclaw*' -ErrorAction SilentlyContinue)",
    "bash(ForEach-Object {)",
    "bash($found += [PSCustomObject]@{ Path = $_.FullName)",
    "bash(Root = $m)",
    "bash(Depth = 1 })",
    "bash($regHit = @())",
    "bash($regPaths = @()",
    "bash([\"HKLM:\\\\SOFTWARE\\\\QCLAW,\"])",
    "bash([\"HKLM:\\\\SOFTWARE\\\\WOW6432Node\\\\QCLAW,\"])",
    "bash([\"HKCU:\\\\SOFTWARE\\\\QCLAW,\"])",
    "bash([\"HKLM:\\\\SOFTWARE\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Uninstall\\\\*,\"])",
    "bash([\"HKLM:\\\\SOFTWARE\\\\WOW6432Node\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Uninstall\\\\*\"])",
    "bash($items = Get-ItemProperty -Path $rp -ErrorAction SilentlyContinue)",
    "bash(Where-Object {)",
    "bash($_.DisplayName -like '*QCLAW*' -or $_.Publisher -like '*QCLAW*' -or $_.InstallLocation -like '*QCLAW*')",
    "bash($regHit += [PSCustomObject]@{)",
    "bash(DisplayName = $it.DisplayName)",
    "bash(InstallLocation = $it.InstallLocation)",
    "bash(Publisher = $it.Publisher)",
    "bash(UninstallString = $it.UninstallString)",
    "bash([PSCustomObject]@{)",
    "bash(CandidateDirs = $results)",
    "bash(SearchHits = $found)",
    "bash(RegistryHits = $regHit)",
    "bash([\"Format-List\"])"
  ],
  "deny": [],
  "ask": []
}
